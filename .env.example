VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
# Set to 'true' in development to fall back to mock data when tables are empty or Supabase is offline;
# set to 'false' in production so an empty table renders an empty state instead of stale mock data.
VITE_USE_MOCK_FALLBACK=true

# Cloudflare Turnstile public site key for public forms (Recruitment, Contact, Sponsor)
# In local development without this key, the Turnstile widget operates in development bypass mode.
VITE_TURNSTILE_SITE_KEY=
